<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The only capability FaceUnlock needs: the camera.
         No network entitlement, and the code links no networking frameworks,
         so the app cannot reach the network. No Accessibility, no Apple Events,
         no keychain-access-groups, no lock-screen or credential capability. -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
